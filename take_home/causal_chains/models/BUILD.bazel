load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//tools/pytest:defs.bzl", "pytest_test")

py_library(
    name = "models",
    srcs = [
        "conversation.py",
        "message.py",
        "sse_event.py",
        "turn.py",
        "turn_status.py",
    ],
    imports = ["../../.."],
    visibility = ["//visibility:public"],
    deps = [
        requirement("pydantic"),
    ],
)

pytest_test(
    name = "turn_status_test",
    srcs = ["turn_status_test.py"],
    imports = ["../../.."],
    deps = [
        ":models",
        requirement("pydantic"),
    ],
)

pytest_test(
    name = "turn_test",
    srcs = ["turn_test.py"],
    imports = ["../../.."],
    deps = [":models"],
)

pytest_test(
    name = "conversation_test",
    srcs = ["conversation_test.py"],
    imports = ["../../.."],
    deps = [":models"],
)

pytest_test(
    name = "message_test",
    srcs = ["message_test.py"],
    imports = ["../../.."],
    deps = [":models"],
)

pytest_test(
    name = "sse_event_test",
    srcs = ["sse_event_test.py"],
    imports = ["../../.."],
    deps = [":models"],
)

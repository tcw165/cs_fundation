load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//tools/pytest:defs.bzl", "pytest_test")

py_library(
    name = "agent_runner",
    srcs = ["app_agent_runner.py"],
    imports = ["../../../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//take_home/causal_chains/agents/agent_run_config",
        "//take_home/causal_chains/agents/agent_runner/protocol",
        "//take_home/causal_chains/agents/clients/memcache/protocol",
        "//take_home/causal_chains/agents/agents/chief_of_staff",  # pragma: allowlist secret
        "//take_home/causal_chains/agents/agents/input_guardrail",
        "//take_home/causal_chains/agents/models",
        "//take_home/causal_chains/agents/models/messaging",
        "//take_home/causal_chains/agents/observability:observability",
        requirement("anyio"),
        requirement("openai"),
        requirement("openai-agents"),
    ],
)

pytest_test(
    name = "agent_runner_test",
    srcs = ["app_agent_runner_test.py"],
    imports = ["../../../.."],
    deps = [
        ":agent_runner",
        "//take_home/causal_chains/agents/clients/memcache",
        "//take_home/causal_chains/agents/agents/chief_of_staff",  # pragma: allowlist secret
        "//take_home/causal_chains/agents/agents/input_guardrail",
        "//take_home/causal_chains/agents/models",
        "//take_home/causal_chains/agents/models/messaging",
        "//take_home/causal_chains/agents/observability:observability",
        requirement("anyio"),
    ],
)

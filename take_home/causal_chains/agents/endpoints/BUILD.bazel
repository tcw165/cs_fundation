load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "health",
    srcs = ["health.py"],
    imports = ["../../../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//take_home/causal_chains/agents/di",
        "//take_home/causal_chains/agents/http_models:health_response",
        requirement("fastapi"),
    ],
)

py_library(
    name = "conversation",

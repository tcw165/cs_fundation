load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//tools/pytest:defs.bzl", "pytest_test")

py_library(
    name = "endpoints",
    srcs = [
        "causal_chains.py",
        "conversation.py",
        "health.py",
    ],
    imports = ["../../../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//take_home/causal_chains/agents/chat_service",
        "//take_home/causal_chains/agents/di",
        "//take_home/causal_chains/agents/endpoints/models",
        "//take_home/causal_chains/agents/http_models",
        "//take_home/causal_chains/agents/models",
        "//take_home/causal_chains/agents/models/messaging",
        "//take_home/causal_chains/agents/models/messaging/turn",
        "//take_home/causal_chains/agents/observability:observability",
        "//take_home/causal_chains/agents/stores/messaging_store/protocol",
        "//take_home/causal_chains/agents/stores/turn_store/protocol",
        requirement("anyio"),
        requirement("fastapi"),
    ],
)

pytest_test(
    name = "endpoints_test",
    srcs = [
        "causal_chains_test.py",
        "conversation_test.py",
        "health_test.py",
    ],
    imports = ["../../../.."],
    deps = [
        ":endpoints",
        "//take_home/causal_chains/agents/chat_service",
        "//take_home/causal_chains/agents/di",
        "//take_home/causal_chains/agents/models/causal_chains",
        "//take_home/causal_chains/agents/models/messaging",
        "//take_home/causal_chains/agents/models/messaging/turn",
        "//take_home/causal_chains/agents/stores/messaging_store",
        "//take_home/causal_chains/agents/stores/turn_store",
        "//take_home/causal_chains/agents/stub_runner",
        requirement("anyio"),
        requirement("dependency-injector"),
        requirement("fastapi"),
    ],
)

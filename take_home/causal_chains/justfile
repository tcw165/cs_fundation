eval-offline query:
    clear
    docker compose up -d --wait graph
    docker compose exec -T graph cypher-shell -u neo4j -p causal_chains \
      "CREATE CONSTRAINT situation_id IF NOT EXISTS FOR (s:Situation) REQUIRE s.situation_id IS UNIQUE"
    NEO4J_URI=bolt://localhost:7687 NEO4J_USER=neo4j NEO4J_PASSWORD=causal_chains \
      bazel run //take_home/causal_chains/agents/eval/offline:offline -- --query "{{query}}"
